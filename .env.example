# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Leave empty for a root-domain deployment.
NEXT_PUBLIC_BASE_PATH=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
# Stores scored attempts for signed-in learners (examsathi_attempts). Without it attempts are scored but not saved.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=

# Web Push reminders (streak-at-risk). Run: node -e "const wp=require('web-push');const k=wp.generateVAPIDKeys();console.log(JSON.stringify(k))"
# CRON_SECRET must be at least 16 characters. Call POST /api/push/send/ with Authorization: Bearer <CRON_SECRET> from your scheduler (e.g. Render Cron, GitHub Actions).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
CRON_SECRET=

# Shared rate limiting (Upstash Redis REST). Required once you run more than one instance; optional for one.
# Without these the limiter is in-memory per instance. If the store is unreachable requests fall back to the in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
